# Copy this file to .env and fill in the values.
# Create a Supabase project (UK or EU region) at https://supabase.com; the
# URL and anon key are under Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The model key never goes here. It is a function secret:
#   supabase secrets set ANTHROPIC_API_KEY=...
